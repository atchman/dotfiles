#
# ~/.bash_aliases
#
#
#
# Write in ~/.bashrc:
#
# Alias definitions.
# if [ -f ~/.bash_aliases ]; then
#     . ~/.bash_aliases
# fi 
#


alias n="nvim"
alias N="sudo nvim"
alias g="cd ~/git" 
alias grubc="sudo grub-mkconfig -o /boot/grub/grub.cfg"
alias grubi="sudo grub-install"
alias commands="nvim ~/Documents/docs/commands"
alias dotfiles='/sbin/git --git-dir=$HOME/git/dotfiles/.git/ --work-tree=$HOME'

alias wetter="curl wttr.in/hamburg"
alias wetter2="curl v2d.wttr.in/hamburg"
alias todo="nvim ~/Documents/docs/todo"
