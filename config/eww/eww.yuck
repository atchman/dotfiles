(include "variables.yuck")
(include "windows.yuck")


(include "modules/bar.yuck")
(include "modules/tray.yuck")




;; Widgets

(defwidget audio []
)

(defwidget battery []
  (box :orientation "v"	
       :space-evenly "false"
  (label :class "bat"		
		 :halign "end"		
		 :text battery	
		 :tooltip "Battery: ${battery-cappacity}%"))
)

(defwidget bright []
)

(defwidget cal []
  (box :class "cal-box"
       :orientation "h"
  (box :class "cal-inner-box"
  (calendar :class "call"
            :day calendar_day
            :month calendar_month
            :year calendar_year
))))

(defwidget cpu []

)

(defwidget disk []

)

(defwidget ethernet []

)


(defwidget language []
  (liveral :content language
))
    

(defwidget memory []

)

(defwidget mic []

)


(defwidget network []
    (box :class "network"
         :orientation "h"
         :space-evenly false
         :halign "start"
    (wlan)
    (ethernet)
))


(defwidget time []
  (box :class "time"
       :orientation "h"
       :space-evenly false
       :halign "center"
       (button :class "time-hour" hour
               :onclick "scripts/calendar")
       (button :class "time-min" min
               :onclick "scripts/calendar")
))

(defwidget temp []

)

(defwidget update []
)


(defwidget win_titel []
    (literal :content win_title
))

(defwidget wlan []
)

(defwidget workspace []
    (literal :content workspace
))



;; Status Bar
(defwidget left []
    (box :class "left_modul"
         :orientation "h"
         :space-evenly false
         :halign "start"
    (workspace)
))

(defwidget center []
    (box :class "center_modul"
         :orientation "h"
         :space-evenly false
         :halign "center"
    (win_title)
))



(defwidget right []
    (box :class "right_modul"
         :orientation "h"
         :space_evenly false
         :halign "end"
    (cpu)
    (temp)
    (mem)
    (disk)
    (update)
    (network)
    (audio)
    (mic)
    (time)
    (cal)
    (language)
    (bright)
    (battery)
))


