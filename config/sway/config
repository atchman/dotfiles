# config for sway
#
# Read `man 5 sway` for a complete reference.

exec ~/.config/sway/config.d/env

include /etc/sway/config.d/*


include /home/atchman/.config/sway/config.d/output
include /home/atchman/.config/sway/config.d/input
include /home/atchman/.config/sway/config.d/keybinds
include /home/atchman/.config/sway/config.d/windowsrules
include /home/atchman/.config/sway/config.d/exec


font xft:JetBrainsMono Nerd Font 13


#exec --no-startup-id dex --autostart --environment i3

# Your preferred application launcher
# Note: pass the final command to swaymsg so that the resulting window can be opened
# on the original workspace that the command was run on.
#set $menu dmenu_path | dmenu | xargs swaymsg exec --


# statusbar
bar {
    swaybar_command i3status
    # swaybar_command waybar
    position top
    strip_workspace_numbers yes
    font xft:JetBrainsMono Nerd Font 13

	separator_symbol "󰇝"
    bindsym button4 nop
    bindsym button5 nop
    bindsym button6 nop
    bindsym button7 nop


    # color
    colors {
        statusline   #f9f9f9
        background   #232629
		separator    #ff0066
				            #border #bg      #txt
        focused_workspace	#232629	#232629	 #2fff00
        inactive_workspace	#232629	#232629	 #808080
		active_workspace	#777F8B	#777F8B	 #ecedee
 	    urgent_workspace	#DEDFE3	#DEDFE3	 #767E8A
	}
}


# only enable this if every app you use is compatible with wayland
# xwayland disable