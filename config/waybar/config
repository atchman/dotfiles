{
    "layer": "top",         // Waybar at top layer
    "position": "top",      // Waybar position (top|bottom|left|right)
    "height": 30,           // Waybar height (to be removed for auto height)
    // "width": 1280,       // Waybar width
    "spacing": 4,           // Gaps between modules (4px)  
    "mod": "dock",
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,  
// choose the order of the modules
    "modules-left": [
            "custom/pacman",
            "hyprland/workspaces",
            "hyprland/window",
            "tray"
    ],
    "modules-center": ["clock"],
    "modules-right": [
            //"tray",
            //"custom/weather",
            "cpu",
            "memory",
            "temperature",
            // "hyprland/language",
            "pulseaudio",
            "pulseaudio#microphone",
            "network",
            "backlight",
            "battery"
    ],


// Modules configuration
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "on-click": "activate",
        "format": "{icon}",
        "format-icons": {
            "1": "󰈹",
            "2": "",
            "3": "󰋜",
            "4": "󰌽",
            "5": "󰮂",
            "6": "",
            "7": "󰙯",
            "8": "󰭹",
            "9": "",
            "0": "󰛤",
            "urgent": "",
            "focused": "",
            "default": ""
        }
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
        // "on-scroll-down": "brightnessctl -c backlight set 1%-",
        // "on-scroll-up": "brightnessctl -c backlight set +1%"
    },
    
    "battery": {
        "bat": "BAT0",
        "states": {
            // "good": 90,
            "warning": 30,
            "critical": 17
        },
        "format": "{icon} {capacity}% ",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": " 󰂃 {capacity}%",
        "format-alt": "{time} {icon}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["󰂎", "󱊡", "󱊢", "󱊣", "󰁹"],
        "tooltip": true,
        "tooltip-format": "󱐥 {power} W\r{timeTo}"
    },
    

    "clock": {
        "timezone": "Europe/Berlin",
        "locale": "de_DE.UTF-8",
        "format": " {:%H:%M}",
        "format-alt": " {:%a, %d. %b %Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
                    "mode"          : "month",
                    "mode-mon-col"  : 3,
                    "weeks-pos"     : "right",
                    "on-scroll"     : 1,
                    "on-click-right": "mode",
                    "format": {
                              "months":     "<span color='#fafafa'><b>{}</b></span>",
                              "days":       "<span color='#fecaca'><b>{}</b></span>",
                              "weeks":      "<span color='#14b8a6'><b>W{}</b></span>",
                              "weekdays":   "<span color='#fbbf24'><b>{}</b></span>",
                              "today":      "<span color='#e11d48'><b><u>{}</u></b></span>"
                              }
        },
        "actions": {
                    "on-click-right": "mode"
        }
    },
    

    "custom/weather": {
        "tooltip": true,
        "format": "{}",
        "restart-interval": 3600,
        "exec": "~/.config/waybar/scripts/gweather.sh",
        "return-type": "json"
    },


    "custom/pacman": {
    "format": "{} 󰣇",
    "interval": "once",
    "exec": "checkupdates | wc -l",
    "signal": 8
    },
    

    "cpu": {
        "interval": 10,
        "format": " {usage}%",
        //"format-alt": "󰻠 {avg_frequency} GHz",
        "tooltip": true,
        "tooltip-format": " {avg_frequency:0.2f}GHz/{total:0.2f}GB"
    },


    "hyprland/language": {
    "format": "{short}",
    "keyboard-name": "at-translated-set-2-keyboard"
    },

    "hyprland/mode": {
        "format": "<span style=\"italic\">{}</span>",
        "tooltip": false
    },
    
    "hyprland/window": {
        "format": "{}",
        "max-length": 25
    },
    

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰈈 ",
            "deactivated": "󰈉 "
        }
    },
    

    "memory": {
        "interval": 30,
        "format": " {}%",
        //"format-alt": " {used}GB",
        "max-length": 10,
        "tooltip": true,
        "tooltip-format": " {used:0.2f} GB / {total:0.2f} GB"
    },
    

    "mpd": {
        "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ⸨{songPosition}|{queueLength}⸩ {volume}% ",
        "format-disconnected": "Disconnected ",
        "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
        "unknown-tag": "N/A",
        "interval": 2,
        "consume-icons": {
            "on": " "
        },
        "random-icons": {
            "off": "<span color=\"#f53c3c\"></span> ",
            "on": " "
        },
        "repeat-icons": {
            "on": " "
        },
        "single-icons": {
            "on": "1 "
        },
        "state-icons": {
            "paused": "",
            "playing": ""
        },
        "tooltip-format": "MPD (connected)",
        "tooltip-format-disconnected": "MPD (disconnected)"
    },
    

    "network": {
        // "interface": "wlan0",
        "interval": 5,
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀 ",
        "tooltip-format": "{ifname} via {gwaddr} 󰩟",
        "tooltip-format-wifi": "  SSID: {essid}\rNI: {ifname}\r󰢽 {signalStrength} %\r󰢽 {signaldBm} dBm\r󱑽 {frequency} MHz\r {bandwidthUpBytes}\r {bandwidthDownBytes}\r󰩟 {ipaddr}\rCIDR /{cidr}\r󰠥 {netmask}\rGW-󰩟 {gwaddr}",
        "tooltip-format-ethernet": " {ifname}\r {bandwidthUpBytes}\r {bandwidthDownBytes}\r󰩟 {ipaddr}i\rCIDR /{cidr}\r󰠥 {netmask}\rGW-󰩟 {gwaddr}",
        "format-linked": "󱘖 {ifname} | No IP",
        "format-disconnected": "⚠ Disconnected"
    },
    

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "tooltip": true,
        "tooltip-format": "{icon} {volume}% {desc}",
        // "format-bluetooth": "{icon} {volume}%",
        // "format-bluetooth-muted": "{icon}  {format_source}",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰥰",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "",
            "car": "󰄋",
            "default": ["", "", ""]
        },
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol -t 3",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%",
        "scroll-step": 5
        
    },
    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": " {volume}%",
        "format-source-muted": " Muted",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-click-right": "pavucontrol -t 4",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
        "scroll-step": 5
      },


    "temperature": {
        //"thermal-zone": "8",
        //"hwmon-path": "/sys/class/hwmon/hwmon5/",
        "hwmon-path": "/sys/class/thermal/thermal_zone8/temp",
        //"input-filename": "temp",
        "critical-threshold": 90,
        "interval": 10,
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["", "", ""],
        "format-critical": "{icon} {temperatureC}°C"
    },
    

    "tray": {
        "icon-size": 21,
        "spacing": 10
    }

}

